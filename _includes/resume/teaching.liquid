<ul class="card-text font-weight-light list-group list-group-flush">
  {% comment %}
    Supports both JSON Resume-like entries (position/name/startDate/summary/highlights)
    and the simplified al-folio "teaching" schema (course/year/role).
  {% endcomment %}

  {% assign teaching = data[1] | sort: 'year' | reverse %}
  {% for content in teaching %}
    {% assign course = content.course | default: content.title | default: content.name | default: content.position %}
    {% assign role = content.role | default: content.position %}
    {% assign org = content.uni | default: content.institution | default: content.organization | default: content.name %}
    {% assign url = content.url %}

    {% comment %} Date badge: prefer `year`, fallback to start/end dates {% endcomment %}
    {% assign badge = content.year %}
    {% if badge == null or badge == '' %}
      {% if content.startDate and content.startDate != '' %}
        {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
        {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
        {% assign badge = startDate | append: ' - ' | append: endDate %}
      {% else %}
        {% assign badge = '' %}
      {% endif %}
    {% endif %}

    {% comment %} Skip rendering fully-empty items {% endcomment %}
    {% assign has_highlights = false %}
    {% if content.highlights and content.highlights.size > 0 %}
      {% assign has_highlights = true %}
    {% endif %}
    {% if (course == null or course == '') and (role == null or role == '') and (org == null or org == '') and (content.summary == null or content.summary == '') and has_highlights == false %}
      {% continue %}
    {% endif %}

    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          <table class="table-cv">
            <tbody>
              {% if badge != null and badge != '' %}
                <tr>
                  <td>
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ badge }} </span>
                  </td>
                </tr>
              {% endif %}
              {% if content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          {% if course != null and course != '' %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">
              {{ course }}
              {% if url and url != '' %}
                <a class="cv-title-link ml-1" href="{{ url }}" aria-label="Link">
                  <i class="fa-solid fa-link"></i>
                </a>
              {% endif %}
            </h6>
          {% endif %}
          {% if role != null and role != '' %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ role }}</h6>
          {% endif %}
          {% if org != null and org != '' and org != course %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ org }}</h6>
          {% endif %}
          {% if content.summary %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.summary }}</h6>
          {% endif %}
          {% if has_highlights %}
            <ul class="items">
              {% for item in content.highlights %}
                <li>
                  <span class="item">{{ item }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
