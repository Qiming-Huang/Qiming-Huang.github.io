<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign teaching = data[1] | sort: 'year' | reverse %}
  {% for content in teaching %}
    {% assign course = content.course | default: content.name | default: content.title %}
    {% assign role = content.role | default: content.position %}
    {% assign year = content.year %}
    {% assign uni = content.uni | default: content.institution | default: content.organization %}

    {% if course == null or course == '' %}
      {% assign course = '-' %}
    {% endif %}
    {% if role == null or role == '' %}
      {% assign role = '-' %}
    {% endif %}
    {% if year == null or year == '' %}
      {% if content.startDate and content.startDate != '' %}
        {% assign year = content.startDate | split: '-' | first %}
      {% else %}
        {% assign year = '-' %}
      {% endif %}
    {% endif %}

    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ year }} </span>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">{{ course }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ role }}</h6>
          {% if uni and uni != '' %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ uni }}</h6>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
